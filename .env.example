# --- Copy to .env and adjust ---

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# AI (leave AI_PROVIDER=heuristic to run without an API key)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# SMTP notifications
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=it-helpdesk@example.com

# Demo credentials created on first boot
SEED_ADMIN_EMAIL=admin@helpdesk.io
SEED_ADMIN_PASSWORD=admin123!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local dev (without Docker) — uncomment if you run uvicorn directly:
# DATABASE_URL=postgresql+psycopg2://helpdesk:helpdesk@localhost:5432/helpdesk
# REDIS_URL=redis://localhost:6379/0
# USE_CELERY=false